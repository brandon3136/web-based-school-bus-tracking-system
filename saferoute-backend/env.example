# Server
PORT=4000
NODE_ENV=development

# CORS / cross-origin frontend URL (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Database (MySQL — Aiven or local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=saferoute
# Set to "true" for Aiven / any managed provider that requires TLS
DB_SSL=false
# Optional: paste the provider's CA certificate (PEM) for full cert verification
# DB_SSL_CA=
# Or point to a local file containing it instead:
# DB_SSL_CA_PATH=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@school.tz

# Transactional email (Brevo HTTP API)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SafeRoute
